{
  "screens": [
    {
      "name": "releases",
      "path": "releases",
      "parent": "shell",
      "blocks": [
        {
          "id": "core.title",
          "widget": {
            "heading": {
              "text": "Releases"
            }
          }
        },
        {
          "id": "core.list",
          "component": "core/releases-list",
          "slots": {
            "badges": []
          }
        }
      ]
    },
    {
      "name": "release",
      "path": "releases/:tag",
      "parent": "shell",
      "data": {
        "release": {
          "source": "core",
          "name": "release",
          "params": {
            "tag": "{route.tag}"
          }
        }
      },
      "blocks": [
        {
          "id": "core.header",
          "component": "core/release-header",
          "slots": {
            "badges": []
          }
        },
        {
          "id": "core.rebuild",
          "component": "core/release-rebuild",
          "when": [
            {
              "field": "release.state",
              "equals": "failed"
            }
          ],
          "permission": "pipeline:run"
        },
        {
          "id": "core.publish",
          "component": "core/release-publish",
          "when": [
            {
              "field": "release.state",
              "equals": "ready"
            }
          ],
          "permission": "release:create:final"
        },
        {
          "id": "core.tests",
          "component": "core/release-tests"
        },
        {
          "id": "core.artifacts",
          "component": "core/release-artifacts",
          "slots": {
            "rows": []
          }
        },
        {
          "id": "core.notes",
          "component": "core/release-notes"
        },
        {
          "id": "core.exports",
          "component": "core/release-exports",
          "when": [
            {
              "field": "release.exports_enabled",
              "equals": true
            }
          ]
        },
        {
          "id": "core.executions",
          "component": "core/release-executions"
        }
      ]
    },
    {
      "name": "home",
      "parent": "shell",
      "blocks": [
        {
          "id": "core.home",
          "component": "core/home-redirect"
        }
      ]
    },
    {
      "name": "versions",
      "path": "versions",
      "parent": "shell",
      "blocks": [
        {
          "id": "core.versions",
          "component": "core/versions"
        }
      ]
    },
    {
      "name": "version",
      "path": "versions/:id",
      "parent": "shell",
      "blocks": [
        {
          "id": "core.version",
          "component": "core/version"
        }
      ]
    },
    {
      "name": "release-notes",
      "path": "releases/:tag/notes",
      "parent": "shell",
      "blocks": [
        {
          "id": "core.notes",
          "component": "core/placeholder",
          "props": {
            "lot": "lot 6",
            "params": [
              "tag"
            ],
            "summary": "Note générée puis éditable, avec la date et l'auteur de la dernière modification.",
            "title": "Note de release"
          }
        }
      ]
    },
