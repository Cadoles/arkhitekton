{
  "name": "arkhitekton-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --build && vite build",
    "postbuild": "node -e \"require('node:fs').writeFileSync('../../internal/web/dist/.gitkeep', '')\"",
    "preview": "vite preview",
