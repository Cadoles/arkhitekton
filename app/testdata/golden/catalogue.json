        "placeholder": "./cmd/app"
      },
      "platforms": {
        "source": "input",
        "label": "Plateformes",
        "help": "os/arch, séparés par des virgules. Vide : linux/amd64 et linux/arm64.",
        "placeholder": "linux/amd64,linux/arm64"
      },
      "private-modules": {
        "source": "input",
        "label": "Modules privés",
        "help": "Les motifs de GOPRIVATE, séparés par des virgules. Vide : l'hôte de la forge du projet.",
        "placeholder": "forge.example.fr"
      },
      "repo-url": {
        "source": "config",
        "key": "project.repoUrl"
      },
      "revision": {
        "source": "input",
        "required": true,
        "suggest": "git-ref"
      },
      "version": {
        "source": "input",
        "required": true,
        "suggest": "release-tag"
      }
    },
    "uploads": {
      "binaries": {
        "param": "binaries-upload-url",
        "artifact": "binaries.tar.gz",
        "group": "build",
        "format": "archive"
      }
    },
    "workspaces": [
      {
        "name": "git-credentials",
