[
  {
    "kind": "docker/build",
    "pipelineRef": "build-image",
    "label": "Construction d'image",
    "produces": [
      "image"
    ],
    "params": {
      "context": {
        "source": "input",
        "label": "Contexte de construction",
        "help": "Répertoire envoyé au moteur de build. Presque toujours la racine.",
        "placeholder": "."
      },
      "dockerfile": {
        "source": "input",
        "label": "Dockerfile",
        "help": "Chemin du fichier qui construit cette image, depuis la racine du dépôt. Dans un plan, `{project.dockerfile}` pour celui du projet.",
        "placeholder": "./Dockerfile"
      },
      "image-name": {
        "source": "input",
        "required": true,
        "suggest": "image-name",
        "label": "Dépôt publié",
        "help": "Nom court du dépôt d'image, sans le registre ni le tag. C'est aussi le nom sous lequel les étapes suivantes désigneront ce qu'il produit.",
        "placeholder": "portal"
      },
      "insecure-registry": {
        "source": "config",
        "key": "registry.insecure"
      },
      "reg-project": {
        "source": "config",
        "key": "registry.project"
      },
      "repo-url": {
        "source": "config",
        "key": "project.repoUrl"
      },
      "revision": {
        "source": "input",
        "required": true,
        "suggest": "git-ref"
      },
      "tag-name": {
        "source": "input",
        "required": true,
        "suggest": "release-tag"
      },
      "target": {
        "source": "input",
        "suggest": "build-target",
        "label": "Cible du Dockerfile",
        "help": "Étape `AS \u003cnom\u003e` qui produit cette image. Sur un Dockerfile sans étapes, la dernière.",
        "placeholder": "web"
      },
      "version": {
        "source": "input",
        "required": true,
        "suggest": "release-tag"
      }
    },
    "workspaces": [
      {
        "name": "git-credentials",
        "secret": {
          "configKey": "project.deployKeySecret"
        }
      },
      {
        "name": "dockerconfig",
        "secret": {
          "configKey": "pipeline.registrySecret"
        }
      },
      {
        "name": "shared-data",
        "volumeClaimTemplate": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "storageClassName": "standard",
          "storage": "2Gi"
        }
      }
    ],
    "Capability": "docker/build",
    "Unavailable": "",
    "ExternalTasks": [
      "git-clone"
    ]
  },
  {
    "kind": "docker/retag",
    "pipelineRef": "retag-image",
    "label": "Re-tag d'image",
    "produces": [
      "image"
    ],
    "maxConcurrent": 1,
    "params": {
      "image-name": {
        "source": "input",
        "required": true,
        "suggest": "image-name"
      },
      "insecure-registry": {
        "source": "config",
        "key": "registry.insecure"
      },
      "new-tag": {
        "source": "input",
        "required": true,
        "suggest": "release-tag"
      },
      "old-tag": {
        "source": "input",
        "required": true,
        "suggest": "release-tag"
      },
      "reg-project": {
        "source": "config",
        "key": "registry.project"
      }
    },
    "workspaces": [
      {
        "name": "dockerconfig",
        "secret": {
          "configKey": "pipeline.registrySecret"
        }
      }
    ],
    "Capability": "docker/retag",
    "Unavailable": "",
    "ExternalTasks": null
  },
  {
    "kind": "docker/scan",
    "pipelineRef": "docker-scan",
    "label": "Scan d'image",
    "produces": [
      "results"
    ],
    "params": {
      "image": {
        "source": "input",
        "required": true,
        "label": "Image",
        "help": "L'image à scanner, avec son registre et son tag. Dans un plan, `{artifacts.\u003cétape\u003e.image}` pour celle qu'une étape a construite."
      },
      "insecure-registry": {
        "source": "config",
        "key": "registry.insecure"
      }
    },
    "uploads": {
      "results": {
        "param": "results-upload-url",
        "artifact": "scan.tar.gz",
        "group": "security",
        "format": "archive"
      }
    },
    "workspaces": [
      {
        "name": "dockerconfig",
        "secret": {
          "configKey": "pipeline.registrySecret"
        }
      },
      {
        "name": "shared-data",
        "volumeClaimTemplate": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "storageClassName": "standard",
          "storage": "1Gi"
        }
      }
    ],
    "Capability": "docker/scan",
    "Unavailable": "",
    "ExternalTasks": [
      "publish-artifact"
    ]
  },
