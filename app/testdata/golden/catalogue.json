[
  {
    "kind": "core/build",
    "pipelineRef": "build-image",
    "label": "Construction d'image",
    "produces": [
      "image"
    ],
    "params": {
      "context": {
        "source": "input",
        "label": "Contexte de construction",
        "help": "Répertoire envoyé au moteur de build. Presque toujours la racine.",
        "placeholder": "."
      },
      "dockerfile": {
        "source": "input",
        "label": "Dockerfile",
        "help": "Chemin du fichier qui construit cette image, depuis la racine du dépôt. Vide : celui du projet.",
        "placeholder": "./Dockerfile"
      },
      "image-name": {
        "source": "input",
        "required": true,
        "suggest": "image-name",
        "label": "Dépôt publié",
        "help": "Nom court du dépôt d'image, sans le registre ni le tag. C'est aussi le nom sous lequel les étapes suivantes désigneront ce qu'il produit.",
        "placeholder": "portal"
      },
      "reg-project": {
        "source": "config",
        "key": "registry.project"
      },
      "repo-url": {
        "source": "config",
        "key": "project.repoUrl"
      },
      "revision": {
        "source": "input",
        "required": true,
        "suggest": "git-ref"
      },
      "tag-name": {
        "source": "input",
        "required": true,
        "suggest": "release-tag"
      },
      "target": {
        "source": "input",
        "required": true,
        "suggest": "build-target",
        "label": "Cible du Dockerfile",
        "help": "Étape `AS \u003cnom\u003e` qui produit cette image. Sur un Dockerfile sans étapes, la dernière.",
        "placeholder": "web"
      },
      "version": {
        "source": "input",
        "required": true,
        "suggest": "release-tag"
      }
    },
    "workspaces": [
      {
        "name": "git-credentials",
        "secret": {
          "configKey": "project.deployKeySecret"
        }
      },
      {
        "name": "dockerconfig",
        "secret": {
          "configKey": "pipeline.registrySecret"
        }
      },
      {
        "name": "shared-data",
        "volumeClaimTemplate": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "storageClassName": "standard",
          "storage": "2Gi"
        }
      }
    ],
    "Capability": "core/build",
    "Unavailable": "",
    "ExternalTasks": null
  },
  {
    "kind": "core/retag",
    "pipelineRef": "retag-image",
    "label": "Re-tag d'image",
    "produces": [
      "image"
    ],
    "maxConcurrent": 1,
    "params": {
      "image-name": {
        "source": "input",
        "required": true,
        "suggest": "image-name"
      },
      "new-tag": {
        "source": "input",
        "required": true,
        "suggest": "release-tag"
      },
      "old-tag": {
        "source": "input",
        "required": true,
        "suggest": "release-tag"
      },
      "reg-project": {
        "source": "config",
        "key": "registry.project"
      }
    },
    "workspaces": [
      {
        "name": "dockerconfig",
        "secret": {
          "configKey": "pipeline.registrySecret"
        }
      }
    ],
    "Capability": "core/retag",
    "Unavailable": "",
    "ExternalTasks": null
  },
  {
    "kind": "php/static-tests",
    "pipelineRef": "php-static-tests",
    "label": "Analyse statique",
    "verification": true,
    "produces": [
      "results"
    ],
    "params": {
      "repo-url": {
        "source": "config",
        "key": "project.repoUrl"
      },
      "revision": {
        "source": "input",
        "required": true,
        "suggest": "git-ref"
      }
    },
    "uploads": {
      "results": {
        "param": "results-upload-url",
        "artifact": "static-tests.tar.gz",
        "group": "static",
        "format": "archive"
      }
    },
    "workspaces": [
      {
        "name": "git-credentials",
        "secret": {
          "configKey": "project.deployKeySecret"
        }
      },
      {
        "name": "shared-data",
        "volumeClaimTemplate": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "storageClassName": "standard",
          "storage": "1Gi"
        }
      }
    ],
    "Capability": "php/static-tests",
    "Unavailable": "",
    "ExternalTasks": [
      "git-clone",
      "composer-install",
      "publish-artifact"
    ]
  },
  {
    "kind": "php/unit-tests",
    "pipelineRef": "php-unit-tests",
    "label": "Tests unitaires",
    "verification": true,
    "produces": [
      "results"
    ],
    "params": {
      "repo-url": {
        "source": "config",
        "key": "project.repoUrl"
      },
      "revision": {
        "source": "input",
        "required": true,
        "suggest": "git-ref"
      }
    },
    "uploads": {
      "results": {
        "param": "results-upload-url",
        "artifact": "unit-tests.tar.gz",
        "group": "unit",
        "format": "archive"
      }
    },
    "workspaces": [
      {
        "name": "git-credentials",
        "secret": {
          "configKey": "project.deployKeySecret"
        }
      },
      {
        "name": "shared-data",
        "volumeClaimTemplate": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "storageClassName": "standard",
          "storage": "1Gi"
        }
      }
    ],
    "Capability": "php/unit-tests",
    "Unavailable": "",
    "ExternalTasks": [
      "git-clone",
      "composer-install",
      "publish-artifact"
    ]
  }
]
