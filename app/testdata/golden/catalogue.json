          "configKey": "project.deployKeySecret"
        }
      },
      {
        "name": "shared-data",
        "volumeClaimTemplate": {
          "accessModes": [
            "ReadWriteOnce"
          ],
          "storageClassName": "standard",
          "storage": "4Gi"
        }
      }
    ],
    "Capability": "go/build",
    "Unavailable": "",
    "ExternalTasks": [
      "git-clone",
      "publish-artifact"
    ]
  },
