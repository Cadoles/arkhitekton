  {
    "kind": "go/build",
    "pipelineRef": "go-build",
    "label": "Binaires Go",
    "produces": [
      "binary"
    ],
    "params": {
      "ldflags": {
        "source": "input",
        "label": "ldflags",
        "help": "`{version}` y est remplacé par la version de la release.",
        "placeholder": "-X main.version={version}"
      },
      "packages": {
        "source": "input",
        "required": true,
        "label": "Paquets",
