# Template of the local overlay's environment file.
#
#   cp dashboard.env.example dashboard.env
#
# `dashboard.env` is ignored by git. No credential must be versioned, here no more than anywhere
# else. Every variable is described in docs/04-configuration.md.

# --- PostgreSQL ---------------------------------------------------------------
# POSTGRES_PASSWORD feeds the PostgreSQL container, DATABASE_DSN the dashboard. Both must carry
# the same password: nothing checks it, and the symptom of a mismatch is a "password
# authentication failed" at start-up.
POSTGRES_PASSWORD=dashboard-local
DATABASE_DSN=postgres://dashboard:dashboard-local@arkhitekton-postgres:5432/dashboard?sslmode=disable

# --- MinIO --------------------------------------------------------------------
# Keep these two values alphanumeric: the bucket-creation Job inserts them into a URL
# (MC_HOST_local), where a character such as `@` or `/` breaks the parsing with no explicit
# message.
MINIO_ACCESS_KEY=dashboardlocal
MINIO_SECRET_KEY=dashboardlocalsecret

# --- Sealing key --------------------------------------------------------------
# Seals the plugins' sensitive settings in the database: tokens, API keys, webhook secrets.
# Required as soon as FORGE_TOKEN or TRACKER_API_KEY is set: the migrate Job seals them, and fails
# without it.
#
#   openssl rand -base64 32
#
# Keep it outside the database: a backup is unreadable without the key that sealed it.
SECRETS_KEY=

# --- OIDC ---------------------------------------------------------------------
# The issuer must match the `iss` claim exactly, trailing slash included: Gitea announces
# "https://forge.cadoles.com/". The discovery happens at start-up, so the issuer must be
# reachable from the pods.
#
# An OAuth2 application declared on the forge (Settings, Applications), with the redirect URL
# http://dashboard.arkhitekton.local/api/v1/auth/callback. The client is checked only at the first sign
# in: the dashboard starts with these placeholders, but nobody can sign in.
OIDC_ISSUER_URL=https://forge.cadoles.com/
OIDC_CLIENT_ID=change-me
OIDC_CLIENT_SECRET=change-me

# --- First administrator ------------------------------------------------------
# Your login on the forge, or your token's `sub`. Without at least one entry the api refuses to
# start: nobody could grant the first role. Applied once, by the migrate Job.
BOOTSTRAP_ADMINS=change-me

# BOOTSTRAP_USERS carries the role with the account, for a whole team before its first sign in.
# Roles: viewer, operator, releaser, admin; an entry with another role is ignored. A declaration
# waits for its holder's first sign in; the unclaimed ones are logged at the api's start-up.
# BOOTSTRAP_USERS=alice:releaser,bob:operator

# --- Image registry -----------------------------------------------------------
# Read to list a repository's tags and resolve digests: where an image was promoted. The three
# are needed together; with one empty, the registry is not read.
#
# Read-only is enough: the images are pushed by the pipelines (docker/build, docker/retag), with
# the credentials of PIPELINE_REGISTRY_SECRET. mstore-pipelines's local overlay replaces these with its
# own registry, `registry-tekton`.
REGISTRY_URL=https://reg.cadoles.com
REGISTRY_USERNAME=change-me
REGISTRY_PASSWORD=change-me

# Where the images are built and promoted. Locally, a personal namespace: a promotion is a real
# re-tag, and sending it into `team` would publish test tags in the shared project.
REGISTRY_PROJECT=reg.cadoles.com/change-me

# --- Tracker (Redmine plugin) -------------------------------------------------
# Seed the Redmine plugin's settings and the first project's tracker, once, when the migrate Job
# first runs; they are edited under Administration, Plugins afterwards.
#
# The plugin only reads: its transport refuses any method other than GET and HEAD. Ask for the
# key of an account that is read-only on the project anyway: the next tool given this key will
# not necessarily have the same guard.
TRACKER_URL=https://change-me
TRACKER_API_KEY=change-me
# The project's identifier, as it appears in the Redmine URL.
TRACKER_PROJECT=change-me

# --- Forge (Gitea plugin) -----------------------------------------------------
# Seed the Gitea plugin's settings and the first project's repository, once, when the migrate Job
# first runs.
#
# The token writes: tags, commit statuses, comments, releases and the projects' deploy keys. It
# needs `write:repository`, from an account that administers the projects' repositories (deploy
# keys). Created on the forge: Settings, Applications, Generate new token.
FORGE_URL=https://forge.cadoles.com
FORGE_TOKEN=change-me
FORGE_REPO=owner/name

# The clone URL is derived from FORGE_URL and FORGE_REPO, over SSH on FORGE_SSH_PORT (2222).
# FORGE_REPO_URL names another one, for a forge whose clone URL cannot be deduced.
# FORGE_REPO_URL=ssh://git@forge.example:2222/owner/name.git
#
# The first project's Dockerfile, from the repository's root (PROJECT_BUILD_CONTEXT).
# PROJECT_DOCKERFILE=Dockerfile

# --- The pipelines' MinIO -----------------------------------------------------
# Distinct from the dashboard's: PIPELINE_MINIO_BUCKET receives what the Mstore plugin's integration
# tests and security audit publish. The local overlay sets the bucket and mstore-pipelines's the host,
# its own MinIO: set the host here only to deploy this overlay without mstore-pipelines's.
# PIPELINE_MINIO_HOST=http://tekton-minio.mstore-pipelines.svc.cluster.local:9000
# PIPELINE_MINIO_BUCKET=mstore-pipeline

# --- The pipelines' credentials -----------------------------------------------
# The dashboard names the Secrets mounted on the pipelines' workspaces, it never reads them. The
# local overlay names the two it creates from `make pipeline-credentials`'s files
# (PIPELINE_GIT_SECRET, PIPELINE_REGISTRY_SECRET): nothing to set here.

# --- Tekton dashboard ---------------------------------------------------------
# Root of the Tekton dashboard, if it is deployed and reachable from the browser: a run's screen
# links there. Empty, the link is not displayed.
# TEKTON_DASHBOARD_URL=https://tekton.example.fr
