# Template of the local overlay's environment file.
#
#   cp dashboard.env.example dashboard.env
#
# `dashboard.env` is ignored by git. No credential must be versioned, here no more than
# anywhere else.

# --- PostgreSQL ---------------------------------------------------------------
# POSTGRES_PASSWORD feeds the PostgreSQL container, DATABASE_URL the dashboard. Both must
# carry the same password: nothing checks it, and the symptom of a mismatch is a "password
# authentication failed" at start-up.
POSTGRES_PASSWORD=dashboard-local
DATABASE_URL=postgres://dashboard:dashboard-local@arkhitekton-postgres:5432/dashboard?sslmode=disable

# --- MinIO --------------------------------------------------------------------
# Keep these two values alphanumeric: the bucket-creation Job inserts them into a URL
# (MC_HOST_local), where a character such as `@` or `/` would break the parsing with no
# explicit message.
MINIO_ACCESS_KEY=dashboardlocal
MINIO_SECRET_KEY=dashboardlocalsecret

# --- OIDC ---------------------------------------------------------------------
# The issuer must match the `iss` claim exactly, trailing slash included: Gitea announces
# "https://forge.cadoles.com/".
#
# Only the discovery happens at start-up — the issuer must therefore be reachable from the
# pods. The client ID and the secret are checked only at the first code exchange: the
# dashboard starts with dummy values, but signing in will fail. For a complete flow, declare
# an OAuth2 application in Gitea with the redirect URL below.
OIDC_ISSUER_URL=https://forge.cadoles.com/
OIDC_CLIENT_ID=a-remplacer
OIDC_CLIENT_SECRET=a-remplacer

# --- Image registry -----------------------------------------------------------
# Serves the inventory: listing a repository's tags, resolving a digest to the tags carrying
# it. The digest → tags resolution is what says where an image was promoted, a promotion being
# only a re-tag of the same digest.
#
# **Read-only is enough.** The dashboard never pushes an image itself: the re-tag is done by
# the `promote-image` Task, with its own credentials. An account with write access would give
# the dashboard a power it does not exercise.
#
# Pending a service account, a personal account will do — it does not leave this file, which
# is not versioned.
REGISTRY_URL=https://reg.cadoles.com
REGISTRY_USERNAME=a-remplacer
REGISTRY_PASSWORD=a-remplacer

# The project the promotions target. **Locally, target your personal namespace**: a promotion
# is a real re-tag, and sending it into `cnous-mse` would publish test tags in the shared
# project.
REGISTRY_PROJECT=reg.cadoles.com/vcarroy

# --- Redmine ------------------------------------------------------------------
# Serves to list the declared versions, their scope and the open anomalies. It is the entry
# point of the process the client described.
#
# **READ-ONLY, AND THE INSTANCE IS THE PRODUCTION ONE.**
#
# The dashboard creates and modifies no version, no request, no note: those are human acts
# performed in Redmine. That prohibition is not an instruction, it is enforced by the code —
# `internal/redmine`'s transport refuses any method other than GET and HEAD before reaching the
# network, and a test checks it on POST, PUT, PATCH and DELETE.
#
# That protects against a programming mistake, not against an over-powerful account. **Ask for
# a key belonging to an account that is read-only on the project.** If the key is that of an
# account that can write, the power exists even if the dashboard does not use it — and the
# next tool wired to this file will not necessarily have the same guard. `CheckAccess` returns
# the account's `admin` flag precisely so that this case shows.
#
# The key is passed in an `X-Redmine-API-Key` header, never as `?key=`: a query string is
# logged by the server and copied into the Go client's error messages.
#
# https is required outside localhost: the key travels with every request.
TRACKER_URL=https://a-remplacer
TRACKER_API_KEY=a-remplacer
# The project's identifier or shorthand, as it appears in the Redmine URL.
TRACKER_PROJECT=a-remplacer

# --- Gitea forge (READ-ONLY) --------------------------------------------------
# Serves the release creation form: offering the repository's branches and tags rather than a
# free-text field, where a typo is discovered only when the build fails. With no token, the
# form falls back to free-text entry.
#
# `internal/gitea`'s transport refuses any method other than GET and HEAD, as for Redmine.
# Setting a tag or publishing a Gitea release will be a distinct client, never a relaxation of
# this one.
#
# **A token with `read:repository` scope is enough** — a full token opens the whole forge in
# its holder's name. Created in Gitea: Settings → Applications → Generate new token.
FORGE_URL=https://forge.cadoles.com
FORGE_TOKEN=a-remplacer
FORGE_REPO=owner/name

# --- Pipeline targeting -------------------------------------------------------
# The clone URL passed to the Tasks is **derived** from FORGE_URL + FORGE_REPO: naming a
# repository up there is enough for the pipelines to build it. There is therefore nothing to
# set here in order to change repository.
#
# FORGE_REPO_URL stays available as an exception, for the case where the clone URL cannot
# be deduced from the API URL — not as the current setting.
# FORGE_SSH_PORT is 2222 by default: Gitea sits behind an ingress that reserves 22 for the
# host, and the port cannot be deduced from the HTTPS URL.

# This one, on the other hand, depends on the **structure** of the repository targeted.
#
# Default: `Dockerfile`, built from the repository's root (PROJECT_BUILD_CONTEXT).
# PROJECT_DOCKERFILE=Dockerfile

# --- The pipelines' MinIO -----------------------------------------------------
#
# Distinct from the dashboard's MinIO: PIPELINE_MINIO_BUCKET carries what the Tasks publish,
# `arkhitekton` what the dashboard writes itself.
#
# The dashboard passes this host to the pipelines as a parameter, where it wins over
# `mse-tekton`'s default. In development it must therefore name the local MinIO, failing which
# the audit targets production storage with development credentials and fails at the
# `normalize` step — after carrying out every one of its scans.
#
# No default: a pipeline that requires it is refused, naming the key.
# Locally: http://tekton-minio.mse-tekton-pipelines.svc.cluster.local:9000
# PIPELINE_MINIO_HOST=
# PIPELINE_MINIO_BUCKET=

# --- The pipelines' credentials -----------------------------------------------
# The dashboard **names** the secrets mounted on the workspaces, it never handles them:
# `secrets` is deliberately absent from its RBAC, and a key passed as a parameter would land in
# the PipelineRun's spec, readable by anyone with `pipelineruns: get` on the namespace. The
# same principle as the presigned URLs — name rather than distribute.
#
# Defaults: `mse-tekton`'s secrets, cut for the real application. The key there is a deploy key
# of `CNOUS/mse` and the registry account (`cflux`) has `push` on `cnous-mse` only: targeting a
# test repository with those values fails at the clone, then at the push.
#
# For a test repository, `make pipeline-credentials` builds the files and the local overlay
# creates the two secrets; it then remains to uncomment:
# PIPELINE_GIT_SECRET=arkhitekton-pipeline-git
# PIPELINE_REGISTRY_SECRET=arkhitekton-pipeline-registry

# --- Seeding the roles --------------------------------------------------------
# Without at least one entry, the dashboard refuses to start: nobody could grant the first
# role, and the symptom — "everyone is refused" — would not name its cause.
#
# The value is the token's `sub` or the Gitea user name.
BOOTSTRAP_ADMINS=vcarroy

# --- Tekton dashboard ---------------------------------------------------------
# Root of the Tekton dashboard, if it is deployed and reachable from the browser. A run's
# screen links there to consult the object as Tekton sees it: resolved parameters, workspaces,
# results — what this dashboard does not project.
#
# Optional: empty, the link is simply not displayed. A dead link would cost more than no link.
# TEKTON_DASHBOARD_URL=https://tekton.example.fr

# --- The pipelines' deploy key ------------------------------------------------
# The **public** half of the key the pipelines present at the clone. Public, hence displayable
# with no precaution: it is what one pastes into a repository's deploy keys, and the
# administration's Projects tab offers it for copying.
#
# It is here and not read from the secret: the dashboard does not have `secrets` in its RBAC
# and must not have it. One key per project would require creating them, hence that permission;
# a single key added to several repositories does the same work without requiring it.
#
# Obtained from the private key mounted in the pipelines:
#   ssh-keygen -y -f deploy/overlays/local/components/pipeline-credentials/pipeline-ssh-key
# PIPELINE_GIT_PUBLIC_KEY=ssh-ed25519 AAAA... dashboard

# --- Seeding the data ---------------------------------------------------------
# Applied **once**, with the schema migration. The database is authoritative afterwards: these
# variables are no longer read, a repository removed from the interface does not come back, and
# a role taken from someone is not granted again at the next deployment.
#
# BOOTSTRAP_ADMINS can only say "administrator": enough to unblock a fresh database, where
# nobody can yet grant anything from the interface.
#
# BOOTSTRAP_USERS carries the role with the account — `alice:releaser,bob:operator` — and
# allows describing a whole team before its first sign-in. Recognised roles: viewer, operator,
# releaser, admin.
#
# Both accept the provider's `sub` or the account name. The subject being known only at the
# first sign-in, the declaration waits for its holder: the unclaimed declarations are logged at
# the api's start-up, the only place where a misspelled identifier shows.
# BOOTSTRAP_USERS=alice:releaser,bob:operator
